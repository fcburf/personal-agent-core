# Google Gemini API Key
# 발급처: https://aistudio.google.com/
GOOGLE_API_KEY="your-gemini-api-key-here"

# ----------------------------------------------------
# [선택] Gemini 모델 설정 (미설정 시 기본값 적용)
# ----------------------------------------------------
# GEMINI_MODEL_SMALL="gemini-3.8-flash"
# GEMINI_MODEL_LARGE="gemini-3.1-pro-preview"   # 3.8-pro는 없음, 2.5-pro는 신규 사용자 차단
# GEMINI_API_VERSION="v1beta"                    # preview 모델은 v1beta에서만 동작

# ----------------------------------------------------
# [선택] LangSmith 추적 설정 (LangGraph 실행 경로 시각화용)
# ----------------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY="your-langchain-api-key-here"
# LANGCHAIN_PROJECT="personal-agent-core"